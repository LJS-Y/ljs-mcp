{
  "name": "ljs-mcp",
  "version": "0.1.0",
  "description": "LJS 插件 MCP server：让 AI 编码助手按场景找到并使用 LJS 的 Vue3 插件",
  "type": "module",
  "bin": {
    "ljs-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "AI.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-data.mjs",
    "dev": "tsc --watch",
    "build:data": "node scripts/build-data.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "sync:data": "node scripts/check-sync.mjs --fix",
    "release:check": "node scripts/check-sync.mjs && npm run build && npm run test:smoke",
    "test:smoke": "node scripts/smoke-test.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ljs",
    "vue3",
    "ai",
    "cursor",
    "claude-code"
  ],
  "license": "MIT",
  "author": "龙九山",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LJS-Y/ljs-mcp.git"
  },
  "homepage": "https://github.com/LJS-Y/ljs-mcp",
  "bugs": {
    "url": "https://github.com/LJS-Y/ljs-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
